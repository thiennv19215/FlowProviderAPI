# Docker Compose-only secrets. Keep .env.production out of Git.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Copy only the rotated tunnel token value into .env.production, never the Docker command.
CLOUDFLARE_TUNNEL_TOKEN=

# FlowProvider production runtime
FLOW_PROVIDER_ENV=production
FLOW_PROVIDER_PUBLIC_BASE_URL=https://api.shopcongngheso5.io.vn

# The database URL is injected by compose.production.yaml from POSTGRES_PASSWORD.
# Do not set FLOW_PROVIDER_DATABASE_URL here unless you intentionally override Compose.

# Set this on the first deployment to create the bootstrap admin API client.
# Generate a separate secret, for example: printf 'fpa_prod_'; openssl rand -hex 32
# After the client exists in PostgreSQL, this may be left blank on later deployments.
FLOW_PROVIDER_BOOTSTRAP_API_KEY=
# Optional separate control-plane secret for X-Admin-Key administration calls.
FLOW_PROVIDER_ADMIN_API_KEY=

FLOW_PROVIDER_WORKER_ENABLED=true
FLOW_PROVIDER_WORKER_POLL_SECONDS=1
FLOW_PROVIDER_WORKER_CONCURRENCY=8
FLOW_PROVIDER_MAX_CONSECUTIVE_POLL_ERRORS=12
FLOW_PROVIDER_MAX_PROVIDER_OPERATION_SECONDS=3600
# Recheck a queued task after no account currently has enough capacity/credits.
FLOW_PROVIDER_ACCOUNT_UNAVAILABLE_RETRY_SECONDS=30

# Optional server-side fallback. Normally supplied by the Chrome extension connection.
FLOW_PROVIDER_FLOW_API_KEY=

# Durable storage for user-supplied reference uploads. The production Compose
# stack mounts this path from a named volume so container rebuilds keep inputs.
# Generated Google Flow outputs are returned as direct provider URLs and are not
# copied into this storage.
FLOW_PROVIDER_LOCAL_STORAGE_PATH=/app/.data/assets

FLOW_PROVIDER_MAX_UPLOAD_BYTES=52428800
FLOW_PROVIDER_MAX_REFERENCE_BYTES=26214400
FLOW_PROVIDER_MAX_REFERENCE_IN_MEMORY_BYTES=26214400
FLOW_PROVIDER_MAX_PROVIDER_OUTPUT_BYTES=1073741824

FLOW_PROVIDER_EXTENSION_HEARTBEAT_SECONDS=60
FLOW_PROVIDER_EXTENSION_HEARTBEAT_GRACE_SECONDS=15
