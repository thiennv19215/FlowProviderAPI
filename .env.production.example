# Docker Compose-only secrets. Keep .env.production out of Git.
# Copy only the rotated tunnel token value into .env.production, never the Docker command.
CLOUDFLARE_TUNNEL_TOKEN=

# FlowProvider production runtime
FLOW_PROVIDER_ENV=production
FLOW_PROVIDER_PUBLIC_BASE_URL=https://api.shopcongngheso5.io.vn
# Shared only by trusted backend callers. Send as Authorization: Bearer <key>.
FLOW_PROVIDER_BOOTSTRAP_API_KEY=
# Shared only by this Provider and its private Chrome connectors. Keep it different from the business API key.
FLOW_PROVIDER_EXTENSION_API_KEY=
FLOW_PROVIDER_WORKER_ENABLED=true
# Global maximum queued jobs dispatched in parallel by this API process.
FLOW_PROVIDER_WORKER_CONCURRENCY=4
FLOW_PROVIDER_MAINTENANCE_INTERVAL_SECONDS=3600
FLOW_PROVIDER_MAINTENANCE_BATCH_SIZE=500
# Opt-in terminal-job deletion; keyed/unknown-outcome jobs are always retained.
FLOW_PROVIDER_JOB_RETENTION_DAYS=0
FLOW_PROVIDER_WORKER_POLL_SECONDS=10
FLOW_PROVIDER_WORKER_POLL_MAX_BACKOFF_SECONDS=300
FLOW_PROVIDER_WORKER_POLL_CLAIM_LEASE_SECONDS=120
FLOW_PROVIDER_WORKER_DISPATCH_LEASE_SECONDS=900
FLOW_PROVIDER_JOB_IMAGE_TIMEOUT_SECONDS=120
FLOW_PROVIDER_JOB_VIDEO_QUEUE_TIMEOUT_SECONDS=180
FLOW_PROVIDER_JOB_VIDEO_RUNNING_TIMEOUT_SECONDS=600

# Optional server-side fallback. Normally supplied by the Chrome extension connection.
FLOW_PROVIDER_FLOW_API_KEY=
FLOW_PROVIDER_PROJECT_STORE_PATH=/data/projects.db
FLOW_PROVIDER_ASSET_STORE_PATH=/data/assets
FLOW_PROVIDER_ASSET_RETENTION_DAYS=30
FLOW_PROVIDER_ACCOUNT_SLOT_CAPACITY=3

FLOW_PROVIDER_EXTENSION_HEARTBEAT_SECONDS=60
FLOW_PROVIDER_EXTENSION_HEARTBEAT_GRACE_SECONDS=15
