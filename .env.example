FLOW_PROVIDER_ENV=development
FLOW_PROVIDER_PUBLIC_BASE_URL=http://localhost:8000
FLOW_PROVIDER_EXTENSION_API_KEY=
FLOW_PROVIDER_ALLOW_SIMULATION_MODE=true
FLOW_PROVIDER_FLOW_API_KEY=
FLOW_PROVIDER_PROJECT_STORE_PATH=/data/projects.db
FLOW_PROVIDER_ASSET_STORE_PATH=/data/assets
FLOW_PROVIDER_ASSET_RETENTION_DAYS=30
FLOW_PROVIDER_ACCOUNT_SLOT_CAPACITY=3
FLOW_PROVIDER_ACCOUNT_RATE_LIMIT_COOLDOWN_SECONDS=180
FLOW_PROVIDER_EXTENSION_HEARTBEAT_SECONDS=60
FLOW_PROVIDER_EXTENSION_HEARTBEAT_GRACE_SECONDS=15
FLOW_PROVIDER_WORKER_ENABLED=true
FLOW_PROVIDER_WORKER_POLL_SECONDS=10
FLOW_PROVIDER_WORKER_POLL_MAX_BACKOFF_SECONDS=300
FLOW_PROVIDER_WORKER_POLL_CLAIM_LEASE_SECONDS=120
# A paid dispatch is only reconciled after this lease expires.
FLOW_PROVIDER_WORKER_DISPATCH_LEASE_SECONDS=900
# Stop polling stale Flow operations after 24 hours; never starts a replacement paid request.
FLOW_PROVIDER_WORKER_RUNNING_TIMEOUT_SECONDS=86400

# Optional MCP adapter overrides. By default it reuses PUBLIC_BASE_URL.
FLOW_PROVIDER_MCP_BASE_URL=http://localhost:8000
FLOW_PROVIDER_MCP_TIMEOUT_SECONDS=300
# Use the OS path separator for multiple roots: ';' on Windows, ':' on Linux/macOS.
FLOW_PROVIDER_MCP_ALLOWED_ROOTS=.
