FLOW_PROVIDER_ENV=development
FLOW_PROVIDER_DATABASE_URL=postgresql+psycopg://flowprovider:flowprovider@postgres:5432/flowprovider
FLOW_PROVIDER_BOOTSTRAP_API_KEY=fpa_dev_change_me
FLOW_PROVIDER_PUBLIC_BASE_URL=http://localhost:8000
FLOW_PROVIDER_WORKER_ENABLED=true
FLOW_PROVIDER_WORKER_POLL_SECONDS=1
FLOW_PROVIDER_WORKER_CONCURRENCY=8
FLOW_PROVIDER_MAX_CONSECUTIVE_POLL_ERRORS=12
FLOW_PROVIDER_MAX_PROVIDER_OPERATION_SECONDS=3600
FLOW_PROVIDER_FLOW_API_KEY=
FLOW_PROVIDER_STORAGE_BACKEND=local
FLOW_PROVIDER_LOCAL_STORAGE_PATH=.data/assets
FLOW_PROVIDER_MAX_UPLOAD_BYTES=52428800
FLOW_PROVIDER_MAX_REFERENCE_BYTES=26214400
FLOW_PROVIDER_MAX_REFERENCE_IN_MEMORY_BYTES=26214400
FLOW_PROVIDER_MAX_PROVIDER_OUTPUT_BYTES=1073741824
FLOW_PROVIDER_EXTENSION_HEARTBEAT_SECONDS=20
FLOW_PROVIDER_EXTENSION_HEARTBEAT_GRACE_SECONDS=15
# Required in production. In the extension popup enter:
# https://provider.example.com/ext/<same-token>
# config.js removes /ext/<token> before the WebSocket request and sends the credential
# in the Sec-WebSocket-Protocol handshake instead, so proxy/access logs do not contain it.
FLOW_PROVIDER_EXTENSION_GATEWAY_TOKEN=
# R2/S3 when FLOW_PROVIDER_STORAGE_BACKEND=r2
FLOW_PROVIDER_R2_ENDPOINT_URL=
FLOW_PROVIDER_R2_ACCESS_KEY_ID=
FLOW_PROVIDER_R2_SECRET_ACCESS_KEY=
FLOW_PROVIDER_R2_BUCKET=
FLOW_PROVIDER_R2_REGION=auto
FLOW_PROVIDER_ASSET_URL_TTL_SECONDS=1800
