{
  "manifest_version": 3,
  "name": "Flow Provider Connector",
  "version": "1.0.11",
  "description": "Connects a signed-in Google Flow browser profile to FlowProviderAPI.",
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Flow Provider"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "identity",
    "offscreen",
    "declarativeNetRequest",
    "webRequest",
    "identity.email"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google/*",
    "https://flow.google.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://flow-content.google/*",
    "https://storage.googleapis.com/*",
    "https://api.shopcongngheso5.io.vn/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://labs.google/*"],
      "js": ["providers/flow/flow-frame-bridge.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116"
}
